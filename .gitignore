# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw video/audio working files (source footage, exports, music beds)
# These stay local: the 216MB screen recording is over GitHub's 100MB file
# limit, and only the finished cuts under public/ are actually served.
# Mirrors .vercelignore so they never get uploaded on deploy either.
/*.mp4
/*.MP4
/*.mp3
/public/roun/promo-preview.mp4
